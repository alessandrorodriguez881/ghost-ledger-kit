# Ghost Ledger Kit environment variables (copy to .env; never commit real values)

# Optional: enables the LLM explanation layer. Without it the fallback template is used.
OPENAI_API_KEY=your-api-key-here

# Optional: another OpenAI-compatible server, e.g. a local model served by Ollama.
# OPENAI_BASE_URL=http://localhost:11434/v1
# Optional: the model name sent to that server (default gpt-4o-mini).
# LEDGER_KIT_LLM_MODEL=llama3.2:1b
# Optional: seconds to wait for an answer, whole number 1 to 120 (default 10).
# LEDGER_KIT_LLM_TIMEOUT=10
